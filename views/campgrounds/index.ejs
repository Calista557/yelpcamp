<% layout("layouts/boilerplate") %>

<div id="map" style="width: 100%; height: 500px"></div>

<h1 class="text-center mb-4">Search and View Our Campgrounds</h1>

<form
  action="/campgrounds"
  method="GET"
  class="d-flex justify-content-center mb-4"
>
  <div class="input-group" style="max-width: 600px;">
    <input
      type="search"
      name="search"
      class="form-control"
      placeholder="Search campgrounds..."
      value="<%= search || '' %>"
    />

    <button
      class="btn btn-primary"
      type="submit"
    >
      Search
    </button>
  </div>
</form>

<% for (let campground of campgrounds) { %>

    <div class="card mb-3">
        <div class="row">

            <div class="col-md-4">
                <% if (campground.images && campground.images.length > 0) { %>
  <img
    src="<%= campground.images[0].thumbnail %>"
    class="img-fluid rounded-start campground-thumbnail"
    alt="<%= campground.title %>"
  >
<% } %>
            </div>

            <div class="col-md-8">
                <div class="card-body">

                    <h2 class="card-title">
                        <%= campground.title %>
                    </h2>

                    <p class="card-text fw-bold">
                        <%= campground.location %>
                    </p>

                    <p class="card-text">
                        <%= campground.description %>
                    </p>

                    <p class="card-text fw-bold">
                        ₦<%= campground.price.toLocaleString() %>
                    </p>

                    <a
                        href="/campgrounds/<%= campground._id %>"
                        class="btn btn-primary"
                    >
                        View Campground
                    </a>

                </div>
            </div>

        </div>
    </div>

<% } %>

<div class="border-top pt-4 mt-5 mb-5 text-center">
    <a
        href="/campgrounds/new"
        class="btn btn-success"
    >
        Add A New Campground
    </a>
</div>
<%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const campgrounds = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    campgrounds.map(campground => ({
      type: "Feature",
      geometry: campground.geometry,
      properties: { popUpMarkup: campground?.properties?.popUpMarkup }
    }))
  ) %>
};
<%- "</script>" %>

<script src="/javascripts/clusterMap.js"></script>