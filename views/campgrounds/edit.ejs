<% layout("layouts/boilerplate") %>

<div class="row">
  <h1 class="text-center mb-4">Edit Campground</h1>

  <div class="col-6 offset-3 mb-4">
    <form
      action="/campgrounds/<%= campground._id %>?_method=PUT"
      method="POST"
      enctype="multipart/form-data"
      novalidate
      class="validated-form"
    >
      <div class="mb-3">
        <label class="form-label" for="title">Title</label>

        <input
          class="form-control"
          type="text"
          id="title"
          name="campground[title]"
          value="<%= campground.title %>"
          required
        />

        <div class="valid-feedback">Looks good!</div>

        <div class="invalid-feedback">
          Please provide a campground title.
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="location">Location</label>

        <input
          class="form-control"
          type="text"
          id="location"
          name="campground[location]"
          value="<%= campground.location %>"
          required
        />

        <div class="valid-feedback">Looks good!</div>

        <div class="invalid-feedback">
          Please provide a campground location.
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="price">Price</label>

        <input
          class="form-control"
          type="number"
          id="price"
          name="campground[price]"
          value="<%= campground.price %>"
          min="0"
          required
        />

        <div class="valid-feedback">Looks good!</div>

        <div class="invalid-feedback">
          Please provide a valid price.
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="description">
          Description
        </label>

        <textarea
          class="form-control"
          id="description"
          name="campground[description]"
          rows="4"
          required
        ><%= campground.description %></textarea>

        <div class="valid-feedback">Looks good!</div>

        <div class="invalid-feedback">
          Please provide a description.
        </div>
      </div>

      <!-- Existing Images -->

      <% if (campground.images.length > 0) { %>
        <div class="mb-4">
          <label class="form-label d-block">
            Current Images
          </label>

          <div class="row">
            <% campground.images.forEach((image) => { %>
              <div class="col-md-3 mb-3">

                <img
                  src="<%= image.url %>"
                  class="img-fluid rounded"
                  alt="<%= campground.title %>"
                />

                <div class="form-check mt-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="deleteImages"
                    value="<%= image.filename %>"
                    id="delete-<%= image.filename %>"
                  />

                  <label
                    class="form-check-label"
                    for="delete-<%= image.filename %>"
                  >
                    Delete
                  </label>
                </div>

              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Add Images -->

      <div class="mb-4">
        <label class="form-label d-block">
          Add Images
        </label>

        <label
          for="images"
          class="btn btn-outline-primary"
        >
          Add Images
        </label>

        <input
          type="file"
          id="images"
          name="image"
          accept="image/*"
          multiple
          hidden
        />

        <span
          id="file-count"
          class="ms-2 text-muted"
        >
          No images selected
        </span>

        <div class="form-text">
          You can have up to 4 images total.
        </div>
      </div>


      <div class="d-flex justify-content-between">
        <button
          class="btn btn-success"
          type="submit"
        >
          Update Campground
        </button>
<a
  href="/campgrounds/<%= campground._id %>"
  class="btn btn-secondary"
>
  Back to Campground
</a>
      </div>
    </form>
  </div>
</div>

<script>
  (() => {
    "use strict";

    const forms = document.querySelectorAll(".validated-form");

    Array.from(forms).forEach((form) => {
      form.addEventListener(
        "submit",
        (event) => {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }

          form.classList.add("was-validated");
        },
        false,
      );
    });
  })();

  const imageInput = document.querySelector("#images");
  const fileCount = document.querySelector("#file-count");

  const existingImages = <%= campground.images.length %>;
  const maxImages = 4;

  let selectedFiles = [];

  const deleteCheckboxes = document.querySelectorAll(
    'input[name="deleteImages"]'
  );

  function getAvailableSlots() {
    const deletedImages = document.querySelectorAll(
      'input[name="deleteImages"]:checked'
    ).length;

    return maxImages - existingImages + deletedImages;
  }

  function syncInputFiles() {
    const dataTransfer = new DataTransfer();

    selectedFiles.forEach((file) => {
      dataTransfer.items.add(file);
    });

    imageInput.files = dataTransfer.files;
  }

  function updateFileCount() {
    const count = selectedFiles.length;

    if (count === 0) {
      fileCount.textContent = "No images selected";
    } else {
      fileCount.textContent =
        `${count} new image${count > 1 ? "s" : ""} selected`;
    }
  }

  function trimSelectedFilesToLimit() {
    const availableSlots = getAvailableSlots();

    if (selectedFiles.length > availableSlots) {
      selectedFiles = selectedFiles.slice(0, Math.max(availableSlots, 0));

      alert(
        "Some selected images were removed because you no longer have enough free slots. " +
        "Re-check the images you want to keep deleted, or select fewer new images."
      );

      syncInputFiles();
      updateFileCount();
    }
  }

  imageInput.addEventListener("change", () => {
    const newFiles = Array.from(imageInput.files);
    const availableSlots = getAvailableSlots();
    const remainingSlots = availableSlots - selectedFiles.length;

    if (remainingSlots <= 0) {
      alert(
        "You cannot add more images. Delete an existing image first."
      );

      syncInputFiles(); 
      return;
    }

    if (newFiles.length > remainingSlots) {
      alert(
        `You can only add ${remainingSlots} more image${
          remainingSlots === 1 ? "" : "s"
        }.`
      );

      syncInputFiles(); // restore previously selected files instead of wiping them
      return;
    }

    selectedFiles = [...selectedFiles, ...newFiles];

    syncInputFiles();
    updateFileCount();
  });

  deleteCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener("change", () => {
      const imageContainer = checkbox.closest(".col-md-3");

      if (checkbox.checked) {
        imageContainer.classList.add("opacity-50");
      } else {
        imageContainer.classList.remove("opacity-50");
      }

      
      trimSelectedFilesToLimit();
    });
  });
</script>