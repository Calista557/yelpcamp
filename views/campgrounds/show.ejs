<% layout("layouts/boilerplate") %>

<div class="row">
  <div class="col-md-8 offset-md-2">

    <h1 class="mb-3">
      <%= campground.title %>
    </h1>

    <h5 class="fw-bold mb-3">
      <%= campground.location %>
    </h5>

<% for (let image of campground.images) { %>
  <img
    src="<%= image.url %>"
    class="img-fluid rounded mb-3"
    alt="<%= campground.title %>"
  >
<% } %>

    <p class="mt-2">
      <%= campground.description %>
    </p>

    <p class="fw-bold fs-5">
      ₦<%= campground.price.toLocaleString() %>
    </p>

    <!-- Campground actions -->
    <div class="border-top pt-3 mt-4 mb-4">
      <div class="d-flex gap-2">

        <a
          href="/campgrounds"
          class="btn btn-secondary"
        >
          Back to Campgrounds
        </a>

        <% if (currentUser && campground.author &&
              campground.author._id.equals(currentUser._id)) { %>

          <a
            href="/campgrounds/<%= campground._id %>/edit"
            class="btn btn-primary"
          >
            Edit
          </a>

          <form
            action="/campgrounds/<%= campground._id %>?_method=DELETE"
            method="POST"
          >
            <button
              class="btn btn-danger"
              type="submit"
            >
              Delete
            </button>
          </form>

        <% } %>

      </div>
    </div>

    
    <% if (currentUser) { %>

      <h2>Leave a review</h2>

      <form
        action="/campgrounds/<%= campground._id %>/reviews"
        method="POST"
        class="mb-3 validated-form"
        novalidate>

        

       
<div class="mb-3">
  <label class="form-label">
    Rating
  </label>

  <div class="star-rating">
    <input type="radio" id="star5" name="review[rating]" value="5" required>
    <label for="star5">★</label>

    <input type="radio" id="star4" name="review[rating]" value="4">
    <label for="star4">★</label>

    <input type="radio" id="star3" name="review[rating]" value="3">
    <label for="star3">★</label>

    <input type="radio" id="star2" name="review[rating]" value="2">
    <label for="star2">★</label>

    <input type="radio" id="star1" name="review[rating]" value="1">
    <label for="star1">★</label>
  </div>

  <div class="invalid-feedback">
    Please choose a rating.
  </div>
</div>

        <div class="mb-3">
          <label
            class="form-label"
            for="reviewbody"
          >
            Review:
          </label>

          <textarea
            class="form-control"
            name="review[body]"
            id="reviewbody"
            cols="30"
            rows="3"
            required
          ></textarea>

          <div class="invalid-feedback">
            Please enter a review.
          </div>
        </div>

        <button
          class="btn btn-success"
          type="submit"
        >
          Submit
        </button>

      </form>

    <% } else { %>

      <div class="alert alert-secondary d-flex justify-content-between align-items-center">
    <span>Want to leave a review?</span>
    <a href="/login" class="btn btn-sm btn-outline-dark">Log in</a>
  </div>
    <% } %>

    
    <h2 class="mb-4">Reviews</h2>

    <div class="row">

      <% if (campground.reviews.length === 0) { %>

        <div class="col-12">
          <div class="alert alert-light border">
            No reviews yet. Be the first to leave a review!
          </div>
        </div>

      <% } else { %>

        <% for (let review of campground.reviews) { %>

          <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">

              <div class="card-body">

 <h5 class="card-title">
  <% for (let i = 1; i <= 5; i++) { %>
  <% if (i <= review.rating) { %>
  <span class="text-warning">★</span>
  <% } else { %>
  <span class="text-muted">☆</span>
  <% } %>
  <% } %>
</h5>

                <p class="card-text">
                  <%= review.body %>
                </p>

                <% if (
                  currentUser &&
                  review.author &&
                  review.author.equals(currentUser._id)
                ) { %>

                  <form
                    action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                    method="POST"
                  >
                    <button
                      class="btn btn-sm btn-danger"
                      type="submit"
                    >
                      Delete
                    </button>
                  </form>

                <% } %>

              </div>
            </div>
          </div>

        <% } %>

      <% } %>

    </div>

  </div>
</div>

<script>
  const stars = document.querySelectorAll(
    'input[name="review[rating]"]'
  );

  stars.forEach((star) => {
    star.addEventListener("click", () => {
      if (star.dataset.clicked === "true") {
        star.checked = false;
        star.dataset.clicked = "false";
      } else {
        stars.forEach((s) => {
          s.dataset.clicked = "false";
        });

        star.dataset.clicked = "true";
      }
    });
  });
</script>